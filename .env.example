# Copy to .env for local development. Never put real values in source control.

# Site
URL=https://aicegertonchapel.netlify.app
ALLOWED_ORIGINS=https://aicegertonchapel.netlify.app,http://localhost:8888
NETLIFY_BUILD_HOOK_URL=

# Supabase server credentials (service role is functions-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ADMIN_MFA_REQUIRED=true

# Contentful delivery is public/read-only; management token is functions-only
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_ENV=master
CONTENTFUL_LOCALE=en-US
CONTENTFUL_DELIVERY_TOKEN=your-public-delivery-token
CONTENTFUL_MANAGEMENT_TOKEN=your-server-only-management-token
CONTENTFUL_WEBHOOK_SECRET=

# Email provider: resend or brevo
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
CHURCH_EMAIL=aicegertonchapel@gmail.com
URGENT_ALERT_EMAIL=

# Cloudflare Turnstile: site key is public and belongs in site-config.js
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# M-Pesa Daraja; keep STK disabled until the owner confirms the shortcode supports it
MPESA_STK_ENABLED=false
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_ACCOUNT_REFERENCE=7506439
DARAJA_CALLBACK_SECRET=

# YouTube; channel ID also belongs in site-config.js for the static page
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# Optional server-side AI triage
AI_TRIAGE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
